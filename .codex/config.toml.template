# Local Codex configuration for the worktree parent directory.
# This file is intentionally outside each Git worktree.

default_permissions = "worktree-parent"
approval_policy = "on-request"
approvals_reviewer = "user"
allow_login_shell = false

[features]
skill_mcp_dependency_install = false

[agents]
enabled = true
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "high"

[permissions.worktree-parent.filesystem]
":minimal" = "read"
":tmpdir" = "write"
":slash_tmp" = "write"

"/Library/Developer/CommandLineTools" = "read"
"~/.pyenv" = "read"

"~/.agents/skills" = "read"
"~/.codex/skills" = "read"
"~/.codex/plugins/cache" = "read"
"~/.codex/templates" = "read"
"~/.codex/attachments" = "read"

"~/.ssh" = "deny"
"~/.aws" = "deny"
"~/.azure" = "deny"
"~/.config/gcloud" = "deny"
"~/.config/gh" = "deny"

"~/.git-credentials" = "deny"
"~/.netrc" = "deny"

"~/.docker" = "deny"
"~/.kube" = "deny"

"~/Library/Keychains" = "deny"


glob_scan_max_depth = 8

[permissions.worktree-parent.filesystem.":workspace_roots"]
"." = "write"
"_shared" = "read"
"git-worktree" = "write"
"git-worktree/main" = "read"
"git-worktree/develop" = "read"

".git" = "read"
".codex" = "read"
"AGENTS.md" = "read"
"CLAUDE.md" = "read"

"**/.env" = "deny"
"**/.env.*" = "deny"
"**/*.pem" = "deny"
"**/*.key" = "deny"
"**/*_rsa" = "deny"
"**/*_ed25519" = "deny"
"**/.npmrc" = "deny"
"**/.pypirc" = "deny"
"**/.netrc" = "deny"

[permissions.worktree-parent.network]
enabled = false

[shell_environment_policy]
inherit = "core"
ignore_default_excludes = false
exclude = [
  "*KEY*",
  "*SECRET*",
  "*TOKEN*",
  "*PASSWORD*",
  "*PASS*",
  "ANTHROPIC_API_KEY",
  "BACKLOG_API_KEY",
  "BRIDGE_SECRET",
  "CODEX_API_KEY",
  "OPENAI_API_KEY",
  "AWS_*",
  "AZURE_*",
  "GITHUB_*",
  "GH_TOKEN",
  "GOOGLE_APPLICATION_CREDENTIALS",
  "NPM_TOKEN",
  "PYPI_*",
  "DATABASE_URL",
  "POSTGRES_URL",
  "REDIS_URL",
  "SSH_AUTH_SOCK",
  "ORACLE_*",
]

[apps._default]
destructive_enabled = false
open_world_enabled = false
default_tools_approval_mode = "prompt"